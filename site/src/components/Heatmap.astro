---
import { heatmapData, heatTools, heatValue, heatColor, metricExtent } from '../lib/heatmap-data.mjs';
import '../styles/heatmap.css';
import { shortTaskLabel } from '../lib/scores.mjs';
import { taskCategoryGroups, taskHeading } from '../lib/task-headings.mjs';
const sources = import.meta.glob('../../../results/published/*/attempts.jsonl', { eager: true, query: '?raw', import: 'default' });
const attempts = Astro.props.attempts ?? Object.values(sources).flatMap(source => source.split('\n').filter(line => line.trim()).map(line => JSON.parse(line)));
const data = heatmapData(Astro.props.models, Astro.props.tasks, attempts);
const initial = data.rows.filter(row => row.latest);
const extent = metricExtent(initial, 'result');
const v2 = data.columns.some(task => task.id.startsWith('v2-'));
---
<section class="scene heatmap" id="heatmap" data-section-label="Heatmap" aria-labelledby="heatmap-title">
  <div class="scene-head heatmap-head"><div><p class="eyebrow"><b>03 / Heatmap</b> &nbsp; Across the task frontier</p><h2 id="heatmap-title" tabindex="-1">Where models spend.</h2></div></div>
  <div class="heat-controls" role="group" aria-label="Heatmap metric">
    {['Result', 'Output tokens', 'Latency'].map((label, index) => <button class="control" type="button" data-heat-metric={['result', 'tokens', 'latency'][index]} aria-pressed={index === 0}>{label}</button>)}
  </div>
  <p id="heatmap-summary">{initial.length} models · {data.columns.length} tasks. Repeated attempts show means; Not run is excluded.</p>
  <div id="heatmap-legend" aria-label="Heatmap color scale"></div>
  <p class="sr" id="heatmap-instructions">Use arrow keys to inspect neighboring cells, Home or End for the row, Control Home or End for the whole grid. Escape dismisses the tooltip. Tab leaves the grid. On narrow screens, scroll horizontally; model names remain visible.</p>
  <figure class="heatmap-figure">
    <div class="heatmap-scroll" role="grid" tabindex="0" aria-label="Model by task heatmap" aria-describedby="heatmap-summary heatmap-instructions" id="heatmap-grid">
      <table role="presentation" class="heatmap-table" style={`--heat-columns:${data.columns.length}`}>
        <thead role="rowgroup"><tr role="row"><th role="columnheader" rowspan={v2 ? 3 : 2} class="heat-model">Model</th>{heatTools.filter(([tool]) => data.columns.some(task => task.tool === tool)).map(([tool, label]) => <th role="columnheader" scope="colgroup" colspan={data.columns.filter(task => task.tool === tool).length}>{label}</th>)}</tr>
          {v2 && <tr role="row">{taskCategoryGroups(data.columns).map(group => <th role="columnheader" scope="colgroup" class="heat-category" colspan={group.count}>{group.label}</th>)}</tr>}
          <tr role="row">{data.columns.map((task, index) => <th role="columnheader" scope="col" title={taskHeading(task)} aria-label={taskHeading(task)}>{v2 ? index + 1 : shortTaskLabel(task.id)}</th>)}</tr>
        </thead>
        <tbody role="rowgroup">{data.rows.map((row, r) => <tr role="row" data-heat-row={r} hidden={!row.latest}>
          <th role="rowheader" scope="row" class="heat-model" aria-label={`${row.model}, ${row.provider}`}>{row.model}</th>
          {row.cells.map((cell, c) => <td role="gridcell" id={`heat-cell-${r}-${c}`} data-heat-cell data-row={r} data-column={c} aria-label={`${row.model} · ${taskHeading(data.columns[c])} · ${heatValue(cell, 'result')}`} style={`--heat-color:${heatColor(cell.result, 'result', extent) ?? 'repeating-linear-gradient(-45deg, transparent 0 .1875rem, #99919f .1875rem .25rem)'}`}><span aria-hidden="true">{cell.result === 0 ? '×' : cell.result === 1 ? '' : cell.result === null ? '—' : '%'}</span></td>)}
        </tr>)}</tbody>
      </table>
    </div>
    <figcaption><span><b data-heat-figure>FIG. 03</b> · Mean per model/task; output includes reasoning. Latency is provider response time.</span><span>Source: published attempts, n = <span id="heatmap-source">{initial.flatMap(row => row.cells).reduce((sum, cell) => sum + cell.attempts, 0)}</span></span></figcaption>
  </figure>
  <details class="heatmap-data"><summary>Show data table</summary><div role="region" tabindex="0" aria-label="Heatmap values" class="heat-data-scroll"><table><caption>All metrics, mean of measured repetitions. Missing values are not zero.</caption><thead><tr>{['Model', 'Provider', 'Task', 'Result', 'Output tokens', 'Latency', 'Attempts'].map(label => <th scope="col">{label}</th>)}</tr></thead><tbody>{data.rows.flatMap((row, r) => row.cells.map(cell => <tr data-heat-data-row={r} hidden={!row.latest}><th scope="row">{row.model}</th><td>{row.provider}</td><td>{cell.task}</td><td>{heatValue(cell, 'result')}</td><td>{heatValue(cell, 'tokens')}</td><td>{heatValue(cell, 'latency')}</td><td>{cell.measured}/{cell.attempts} measured</td></tr>))}</tbody></table></div></details>
  <p class="sr" id="heatmap-status"></p>
  <div id="heatmap-tooltip" role="tooltip" hidden></div>
  <script type="application/json" id="heatmap-records" set:html={JSON.stringify(data).replaceAll('<', '\\u003c')} />
</section>
