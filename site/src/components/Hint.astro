---
interface Props { id: string; label: string; text: string; class?: string; style?: string }
const { id, label, text, class: className, style } = Astro.props;
---
<button type="button" class:list={['hint-trigger', className]} style={style}
  interestfor={id} popovertarget={id} popovertargetaction="show" aria-expanded="false">
  <slot />
  <span class="sr-only">{label}</span>
</button>
<div id={id} class="hint" popover="hint" role="tooltip">{text}</div>
