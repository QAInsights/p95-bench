---
import data from '../data/leaderboard.json';
import weights from '../../../src/p95bench/category-weights.json';
import { name } from '../lib/scores.mjs';
import { executionShapes, simulatorRows, attemptCost } from '../lib/explainer-data.mjs';
import '../styles/explainer.css';

const { tasks } = Astro.props;
const stages = ['Pipeline', 'Real checkouts', 'Scoring math', 'Cost'];
const graders = [...new Set(tasks.map(task => task.grader))];
const caps = [...new Set(data.models.map(model => model.output_cap).filter(Boolean))];
const initial = data.models[0];
const simulation = simulatorRows(tasks, initial.per_task_results, weights);
const shapes = executionShapes(tasks);
const descriptions = {
  numeric: 'A finite bare number within the tolerance in its task definition. Markdown and prose fail.',
  choice: 'Only the bare answer letter. Case and surrounding whitespace are ignored.',
  jmeter_exec: 'A complete jmeterTestPlan XML block, executed against the demo shop. Successful samples and exact completions are required.',
  k6_exec: 'One js/javascript code block, executed against the demo shop. HTTP success, exact completions and task-specific VU/iteration checks are required.',
};
const pipeline = [
  { title: 'Task pack', metric: `${tasks.length} YAML tasks`, detail: 'Task prompts, fixtures and grading parameters are versioned together. Every provider receives the same system and task prompt.' },
  { title: 'Direct provider API', metric: `${new Set(data.models.map(model => model.provider)).size} providers`, detail: `No model router. Published runs use an output cap of ${caps.map(cap => cap.toLocaleString('en-US')).join(' / ')} tokens, including reasoning where applicable.` },
  { title: 'Deterministic graders', metric: `${graders.length} graders`, detail: 'The task selects its grader. A response either passes or fails its contract; there is no model judging another model.' },
  { title: 'Reproduction artifacts', metric: 'JSONL + JSON + scripts', detail: 'attempts.jsonl records responses, usage and verdicts. summary.json records category scores. Execution keeps scripts and logs.' },
];
const cost = attemptCost(initial.cost_attempts[0]);
---
<section class="reading-section explainer" id="explainer" data-section-label="How scoring works">
  <p class="eyebrow">06 / OPEN THE BLACK BOX</p>
  <h2 tabindex="-1">How scoring works.</h2>
  <p class="section-copy">Showing p95-v1. From a versioned prompt to a verified checkout. Follow the run, then change the results yourself. No hidden judge, no mystery weights.</p>
  <div class="ex-stage-buttons" role="group" aria-label="Scoring explainer stages" hidden>
    {stages.map((stage, index) => <button type="button" data-ex-stage={index} aria-pressed={String(index === 0)} aria-controls={`ex-panel-${index}`}><span>{String(index + 1).padStart(2, '0')}</span>{stage}</button>)}
  </div>

  <div class="ex-panel" id="ex-panel-0" data-ex-panel>
    <h3>A benchmark run, end to end.</h3>
    <p class="ex-copy">Select a step to inspect the contract. The same pipeline runs for every published model.</p>
    <ol class="ex-pipeline" role="list">
      {pipeline.map((step, index) => <li><button type="button" data-pipeline={index} aria-pressed={String(index === 0)}><span class="ex-kicker">{String(index + 1).padStart(2, '0')} / {step.title}</span><strong>{step.metric}</strong><span aria-hidden="true">→</span></button></li>)}
    </ol>
    <p class="ex-callout" id="ex-pipeline-detail">{pipeline[0].detail}</p>
    <div class="ex-graders">
      {graders.map(grader => <article><h4>{grader}</h4><p class="ex-kicker">{tasks.filter(task => task.grader === grader).length} tasks</p><p>{descriptions[grader] ?? 'Checks are defined in the task YAML.'}</p></article>)}
    </div>
    <p class="ex-copy">Inspect the source: <a href="https://github.com/QAInsights/p95-bench/tree/main/tasks">task pack ↗</a> · <a href="https://github.com/QAInsights/p95-bench/tree/main/results/published">published artifacts ↗</a></p>
  </div>

  <div class="ex-panel" id="ex-panel-1" data-ex-panel>
    <h3>Why scripts can't fake a checkout.</h3>
    <p class="ex-copy">Each grade starts a fresh loopback demo app. Every login creates a random session cookie and a new CSRF token. The script must list products, add to the cart and check out using that session's token.</p>
    <div class="ex-shapes" role="group" aria-label="Required execution shapes">
      {shapes.map((shape, index) => <button type="button" class="ex-shape" data-ex-shape={index} aria-pressed={String(index === 0)}>
        <strong>{shape.vus} VU{shape.vus === 1 ? '' : 's'} × {shape.iterations} iter{shape.iterations === 1 ? '' : 's'}</strong>
        <span class="ex-kicker">{shape.title}</span>
        {Array.from({ length: shape.vus }, (_, vu) => Array.from({ length: shape.iterations }, (_, iteration) => <span class="ex-flow-row">
          <span>VU {vu + 1} · iter {iteration + 1}</span>
          <span class="ex-flow"><span style="--step:0">Login + CSRF</span><span style="--step:1">Products + cart</span><span style="--step:2">Checkout ✓</span></span>
        </span>))}
      </button>)}
    </div>
    <p class="ex-callout" id="ex-shape-detail">{shapes[0].completions} verified checkout. Fresh session and token required.</p>
    <div class="ex-graders ex-verification">
      <article><h4>Replay does not count.</h4><p>Each session permits one completed checkout. Reusing it returns a flow conflict. Missing or stale CSRF tokens are rejected.</p></article>
      <article><h4>The verifier keeps the receipt.</h4><p>Only the harness knows the admin key for <code>/internal/stats</code>. It checks actual server-side completions, not a script's printed claims.</p></article>
    </div>
    <p class="ex-copy">The diagrams show the required prompt shapes. Both engines check successful requests and exact completions. k6 also verifies the refresh VU/iteration shape; JMeter does not currently check iteration shape. This is an execution check, not a security sandbox.</p>
  </div>

  <div class="ex-panel" id="ex-panel-2" data-ex-panel>
    <div class="ex-score-head"><div><h3>Every point is accounted for.</h3><p class="ex-copy">Change a task's result. Watch its category, effective weight and overall score respond.</p></div><div><span class="ex-kicker">SIMULATED OVERALL</span><output id="ex-score" aria-live="off">{simulation.overall_score.toFixed(2)}</output></div></div>
    <div class="ex-controls">
      <label for="ex-model">Load a published run</label><select id="ex-model">{data.models.map((model, index) => <option value={index}>{name(model.model)}</option>)}</select>
      <button type="button" class="control" data-ex-preset="pass">All pass</button><button type="button" class="control" data-ex-preset="fail">All fail</button><button type="button" class="control" data-ex-preset="not_run">Nothing run</button>
    </div>
    <p class="ex-formula">Overall = Σ (category pass rate × category weight) ÷ <strong id="ex-weight">{simulation.measured_weight}</strong> measured weight</p>
    <p class="ex-copy" id="ex-sim-meta"></p>
    <dl class="ex-category-rows" id="ex-categories"></dl>
    <p class="ex-callout">Not run is not a fail. Missing tasks are excluded from their category's average. Entirely unmeasured categories leave the denominator. This can increase the effective points of the remaining tasks; equal scores do not imply equal coverage.</p>
    <ul class="ex-task-pills" role="list">
      {tasks.map(task => <li class="ex-task" data-ex-task={task.id}>
        <div><h4>{task.title ?? task.id}</h4><p class="ex-kicker">{task.category} · {task.tool === 'none' ? 'General' : task.tool}</p><p data-ex-points></p></div>
        <div role="group" aria-label={`${task.title ?? task.id} result`}>
          {['pass', 'fail', 'not_run'].map(state => <button type="button" data-ex-state={state} aria-label={`${task.title ?? task.id}: ${state === 'not_run' ? 'Not run' : state === 'pass' ? 'Pass' : 'Fail'}`} aria-pressed="false">{state === 'not_run' ? 'Not run' : state === 'pass' ? 'Pass' : 'Fail'}</button>)}
        </div>
      </li>)}
    </ul>
  </div>

  <div class="ex-panel" id="ex-panel-3" data-ex-panel>
    <h3>Tokens in. List-price estimate out.</h3>
    <p class="ex-copy">Inspect a real attempt, not an invented example. Reasoning tokens count as output when the provider includes them in completion usage. A failed answer still costs money.</p>
    <div class="ex-controls"><label for="ex-cost-model">Published model</label><select id="ex-cost-model">{data.models.map((model, index) => <option value={index}>{name(model.model)}</option>)}</select><label for="ex-cost-attempt">Attempt</label><select id="ex-cost-attempt">{initial.cost_attempts.map((attempt, index) => <option value={index}>{attempt.task_id}</option>)}</select></div>
    <p class="ex-formula">Cost = ((input − cached) × input price + cached × cached price + output × output price) ÷ 1,000,000</p>
    <div class="ex-cost-parts" id="ex-cost-parts">{cost.parts.map(part => <article><h4>{part.label}</h4><strong>{part.tokens.toLocaleString('en-US')} tokens</strong><p>${part.rate} / million</p><p>${part.cost.toFixed(6)}</p></article>)}</div>
    <p class="ex-cost-total" id="ex-cost-total">Attempt estimate: ${cost.total.toFixed(6)}</p><p class="ex-copy" id="ex-model-cost"></p>
    <p class="ex-copy">Cached input is clamped between zero and total input before billing. Prices are the per-attempt list-price snapshots in the artifacts, not credits, discounts or a provider invoice.</p>
  </div>

  <aside class="ex-rules"><h3>Rules we hold.</h3><ul>
    <li>Strict formats: numeric and choice replies must be only the bare number or letter. Markdown or prose fails, by design, as an instruction-following test.</li>
    <li>Identical system/task prompts and the same published output cap ({caps.map(cap => cap.toLocaleString('en-US')).join(' / ')} tokens) for all models.</li>
    <li>Temperature is omitted where providers reject it. Provider exceptions are documented in the artifacts and methodology.</li>
    <li>Not run is not a fail. Missing coverage is visible; unmeasured categories are excluded.</li>
    <li>Costs are list-price estimates calculated from returned usage.</li>
  </ul></aside>
  <script type="application/json" id="ex-data" set:html={JSON.stringify({ tasks: tasks.map(({ id, title, category, tool }) => ({ id, title, category, tool })), pipeline: pipeline.map(step => step.detail), shapes }).replaceAll('<', '\\u003c')} />
</section>
