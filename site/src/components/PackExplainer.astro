---
import Explainer from './Explainer.astro';
import { name, selectModelVersions } from '../lib/scores.mjs';
const { pack, data } = Astro.props;
---
{pack === 'v1' ? <Explainer tasks={data.tasks} /> : <section class="reading-section explainer" id="explainer" data-section-label="How scoring works">
  <p class="eyebrow">06 / OPEN THE BLACK BOX</p><h2 tabindex="-1">How v2 scoring works.</h2>
  <p class="section-copy">V2 is the default landing view. Select v1 in the header for the legacy board.</p>
  <p class="section-copy">Showing p95-v2.0.0 · {data.tasks.length} public tasks, no held-out tasks. Every model is scored on the same tasks with a 16,384-token output cap. Costs use reported token usage at registry prices, not provider invoices.</p>
  <div class="ex-graders">
    <article><h3>Checkpoint quality</h3><p>Each task has 100 possible checkpoint points. Prerequisites cap dependent credit. Task means are weighted by category; repetitions are averaged.</p></article>
    <article><h3>Composite · 95 / 5</h3><p>Composite = 0.95 × quality + 0.05 × quality-gated efficiency. Each task's token and response-latency efficiencies are multiplied by its quality before aggregation. Efficiency cannot rescue incorrect work; grading time is excluded.</p></article>
    <article><h3>Independent evidence</h3><p>Pinned JMeter and k6 workers execute against the demo. Server-owned audit events verify operations; workload tasks require a capacity preflight. No model judges another model.</p></article>
  </div>
  <div class="heat-data-scroll" role="region" tabindex="0" aria-label="Published v2 quality and composite scores">
    <table><caption>Published v2 runs · quality and composite out of 100</caption><thead><tr><th scope="col">Model</th><th scope="col">Quality</th><th scope="col">Efficiency (gated)</th><th scope="col">Composite</th><th scope="col">Repeats</th></tr></thead>
      <tbody>{selectModelVersions(data.models, true).map(model => <tr data-pack-model={model.model}><th scope="row">{name(model.model)}</th><td>{model.not_run ? 'Not run on v2' : model.quality_score.toFixed(2)}</td><td>{model.not_run ? '—' : model.efficiency_score.toFixed(2)}</td><td>{model.not_run ? '—' : model.overall_score.toFixed(2)}</td><td>{model.not_run ? '—' : model.repeats}</td></tr>)}</tbody>
    </table>
  </div>
  {data.budget_file_sha256 && <p class="section-copy" style="overflow-wrap:anywhere">Frozen efficiency budgets · SHA256 <code>{data.budget_file_sha256}</code>. Token budgets are three times reference output length; latency budgets are 90 seconds for analysis and 180 seconds for scripts. Provider output tokens and model API latency receive full credit through budget, then linear credit to zero at three times budget.</p>}
  {data.models.filter(model => !model.not_run && model.evaluator_segments).map(model => <div data-pack-model={model.model}>
    <p class="section-copy">{name(model.model)} · evaluator provenance:</p>
    {model.evaluator_segments.map(segment => <p class="section-copy" style="overflow-wrap:anywhere">
      {segment.label ?? 'Evaluation segment'} · {segment.scored_attempts} scored attempts. Evaluator SHA256: <code>{segment.digest}</code>.
      {segment.public_harness_digest && <span> Public harness SHA256: <code>{segment.public_harness_digest}</code>. Commit: <code>{segment.public_harness_commit}</code>.</span>}
    </p>)}
    {model.grading_note && <p class="section-copy">{name(model.model)} · {model.grading_note}</p>}
  </div>)}
</section>}
