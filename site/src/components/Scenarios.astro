---
import { buildScenarios, scenarioFilters } from '../lib/scenarios.mjs';
const { tasks, models, pack } = Astro.props;
const scenarios = buildScenarios(tasks, models);
const filters = scenarioFilters(scenarios);
---
<section class="reading-section scenarios" id="scenarios" aria-labelledby="scenarios-title" data-section-label="Scenarios">
  <p class="eyebrow">05 / INSIDE THE TASK PACK</p>
  <h2 id="scenarios-title" tabindex="-1">Scenarios.<br />Every public task, in the open.</h2>
  <p class="subcopy">Pack {pack} · Published evidence only. Missing runs are not failures. Counts follow the earlier-versions control.</p>
  <div class="scenario-toolbar">
    <div class="scenario-filters" role="group" aria-label="Filter scenarios by tool">
      {filters.map(filter => <button class="control" type="button" data-scenario-filter={filter.tool} aria-pressed={String(filter.tool === 'all')} aria-controls="scenario-list">{filter.label}</button>)}
    </div>
    <p class="scenario-count" id="scenario-count">Showing {scenarios.length} of {scenarios.length} scenarios</p>
  </div>
  <ul class="scenario-list" id="scenario-list" role="list">
    {scenarios.map(scenario => <li class="scenario-card" data-scenario-tool={scenario.tool} data-scenario-id={scenario.id}>
      <div class="scenario-tags"><span>{scenario.category}</span><span>{scenario.toolLabel}</span></div>
      <h3>{scenario.title}</h3>
      {scenario.title !== scenario.id && <code>{scenario.id}</code>}
      <dl><div><dt>The task</dt><dd>{scenario.summary}</dd></div><div><dt>How it is graded</dt><dd>{scenario.grading}</dd></div></dl>
      <div class="scenario-results"><strong>{scenario.passLabel}</strong><span data-scenario-missing>{scenario.notRun} not run</span></div>
    </li>)}
  </ul>
  <p class="scenario-empty" id="scenario-empty" hidden={scenarios.length > 0}>No scenarios match this tool.</p>
  <p class="scenario-note">{pack === 'v2' ? 'v2 uses mean checkpoint credit, not binary pass/fail. Only public tasks are described here; held-out details are never published.' : 'A model passes only if every published attempt passes. Descriptions come from checked-in task definitions.'}</p>
</section>
