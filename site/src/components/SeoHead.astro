---
import { canonicalUrl, SITE_URL } from "../lib/seo.mjs";

const { title, description, path = "/", jsonLd } = Astro.props;
const url = canonicalUrl(path);
const ogImage = `${SITE_URL}/og-image.png`;
---

<link rel="canonical" href={url} />
<link rel="alternate" type="application/rss+xml" title="P95 Bench Updates" href={`${SITE_URL}/rss.xml`} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="application-name" content="P95 Bench" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="P95 Bench" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="P95 Bench leaderboard showing top AI models on JMeter, k6, Locust, and Gatling with the 3D Speed, Cost, and Quality Pareto Chamber" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
