---
import { canonicalUrl, SITE_URL } from "../lib/seo.mjs";

const { title, description, path = "/", jsonLd } = Astro.props;
const url = canonicalUrl(path);
const ogImage = `${SITE_URL}/icon-512.png`;
---

<link rel="canonical" href={url} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="application-name" content="P95 Bench" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="P95 Bench" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
