---
import "@fontsource/bricolage-grotesque/latin-400.css";
import "@fontsource/bricolage-grotesque/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "../styles/geist.css";
import "../styles/board.css";
import { parse } from "yaml";
import data from "../data/leaderboard-p95-core.json";
import { boardTasks, categoryBlurbs, categoryLabels, taskCode, taskDetails, toolLabel, TOOLS } from "../lib/board.mjs";
import SeoHead from "../components/SeoHead.astro";
import { tasksJsonLd } from "../lib/seo.mjs";

const sources = import.meta.glob("../../../packs/p95-core/tasks/**/*.yaml", { eager: true, query: "?raw", import: "default" });
const tasks = taskDetails(Object.values(sources).map(source => parse(source)), boardTasks(data));
const categories = Object.keys(data.weights);
const groups = categories.map(c => ({ category: c, tasks: tasks.filter(t => t.category === c) }));
const tools = TOOLS.map(tool => ({ tool, count: tasks.length }));
const repo = "https://github.com/QAInsights/p95-bench";
const pageTitle = "Tasks · P95 Bench";
const pageDesc = `The ${tasks.length} public P95 Bench scenarios, each written for JMeter, k6, Locust and Gatling (${tasks.length * tools.length} executable tasks).`;
const jsonLd = tasksJsonLd({ scenarioCount: tasks.length, taskTotal: tasks.length * tools.length });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#0c0b10" />
    <SeoHead title={pageTitle} description={pageDesc} path="/tasks" jsonLd={jsonLd} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistPixel-Grid.woff2" as="font" type="font/woff2" crossorigin />
    <title>Tasks · P95 Bench</title>
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href="/" aria-label="P95 Bench, home"><img src="/favicon.svg" width="24" height="24" alt="" aria-hidden="true" /><span><span class="brand-p95">P95</span> <span class="brand-bench">Bench</span></span></a>
      <nav aria-label="Site"><a href="/#rankings">Rankings</a><a href="/tasks" aria-current="page">Tasks</a><a href="/#method">Method</a><a href={repo}>GitHub ↗</a></nav>
    </header>

    <main>
      <section class="page-intro">
        <h1><span class="lime">{tasks.length}</span> scenarios × {tools.length} tools = {tasks.length * tools.length} tasks</h1>
        <p>Core covers {tasks.length} scenarios across JMeter, k6, Locust and Gatling, for {tasks.length * tools.length} tasks. Each task gives a model one performance-testing job; the generated script runs against a demo shop, and graders award points for each check it passes. Every task file is <a href={`${repo}/tree/main/packs/p95-core/tasks`}>in the repo</a>.</p>
      </section>

      <section aria-labelledby="count-title">
        <h2 id="count-title" class="label">By category <span>count · weight in the score</span></h2>
        <div class="stats">
          {groups.map(g => <a class="stat" href={`#${g.category}`}><b>{g.tasks.length}</b><span>{categoryLabels[g.category]} · {data.weights[g.category]}%</span></a>)}
        </div>
        <div class="stats tools" style="margin-top:12px">
          {tools.map(t => <div class="stat"><b>{t.count}</b><span>{toolLabel(t.tool)} tasks</span></div>)}
        </div>
      </section>

      {groups.map(g => (
        <section id={g.category} class="task-group" aria-labelledby={`${g.category}-title`}>
          <h2 id={`${g.category}-title`} class="label">{categoryLabels[g.category]} <span>{g.tasks.length} tasks · {data.weights[g.category]}% of the score</span></h2>
          <p class="blurb">{categoryBlurbs[g.category]}</p>
          <div class="table-wrap">
            <table class="tasks">
              <thead><tr><th>Code</th><th>Task</th><th>Checks</th></tr></thead>
              <tbody>
                {g.tasks.map(t => (
                  <tr>
                    <td class="code">{taskCode(t.id)}</td>
                    <td class="summary"><b>{t.label}</b><span>{t.summary}</span></td>
                    <td class="checks">{t.checks.length ? t.checks.join(" → ") : "JSON fields"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </main>

    <footer class="bottom">
      <span>Pack {data.pack_id}</span>
      <a href="/">Back to the board</a>
    </footer>
  </body>
</html>
