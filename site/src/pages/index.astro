---
import "@fontsource/bricolage-grotesque/latin-400.css";
import "@fontsource/bricolage-grotesque/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "../styles/global.css";
import data from "../data/leaderboard.json";
import { name, toolScore, toolScoreLabel, selectModelVersions } from "../lib/scores.mjs";
import { parse } from "yaml";
import { buildScenarios, scenarioFilters } from "../lib/scenarios.mjs";

const { weights } = data;
const models = selectModelVersions(data.models);
const allModels = selectModelVersions(data.models, true);
const taskSources = import.meta.glob("../../../tasks/**/*.yaml", { eager: true, query: "?raw", import: "default" });
const tasks = Object.values(taskSources).map(source => parse(source));
const scenarios = buildScenarios(tasks, data.models);
const filters = scenarioFilters(scenarios);
const colors = {
  authoring: "#6b2a7a",
  correlation: "#c4416a",
  workload: "#ff7a3d",
  analysis: "#ffc94a",
  concepts: "#a587e8",
  repair: "#2a1a4a",
  migration: "#75688b",
};
const categories = Object.keys(weights);
const active = categories.filter((c) =>
  models.some((m) => c in m.category_scores),
);
const inactive = categories.filter((c) => !active.includes(c));
const activeWeight = active.reduce((sum, c) => sum + weights[c], 0);
const totalSamples = models.reduce(
  (sum, m) => sum + m.per_task_results.length,
  0,
);
const uniqueTasks = new Set(
  models.flatMap((m) => m.per_task_results.map((t) => t.task_id)),
).size;
const latestDate = models
  .map((m) => m.run_date)
  .filter(Boolean)
  .sort()
  .at(-1);
const latestRun = latestDate
  ? new Date(latestDate)
      .toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
      .toUpperCase()
  : "PUBLISHED RUNS";
const toolRanking = [...allModels].sort(
  (a, b) => (toolScore(b, "jmeter") ?? -1) - (toolScore(a, "jmeter") ?? -1),
);
const k6Ranking = [...allModels].sort(
  (a, b) => (toolScore(b, "k6") ?? -1) - (toolScore(a, "k6") ?? -1),
);
const repo = "https://github.com/QAInsights/p95-bench";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="description" content="An open benchmark for AI on performance test scripting and engineering. Real model runs, executable JMeter tests and transparent scoring." />
    <meta name="theme-color" content="#0c0b10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>P95 Bench · Under load</title>
  </head>
  <body>
    <a class="skip" href="#opening-title">Skip to experience</a>
    <header>
      <div class="brand-group">
        <a class="wordmark" href="#scene-1" aria-label="P95 Bench, first scene"
          ><img
            src="/favicon.svg"
            width="27"
            height="27"
            alt=""
            aria-hidden="true"
          />
          <span>P95 Bench</span></a
        ><label class="version-switch" for="show-versions"><input id="show-versions" type="checkbox" switch role="switch" aria-describedby="versions-help" />Show earlier versions</label>
        <p class="sr" id="versions-help">Latest means the newest benchmarked release in each family. Earlier versions remain fully ranked when shown. Discontinued means the provider no longer offers the model.</p>
      </div><div class="header-tools">
        <a class="header-link" href="#method">Method</a><a
          class="header-link"
          href={repo}>GitHub ↗</a
        ><span class="muted" id="published-date">{latestRun}</span><span class="pill"
          ><span class="dot"></span><span data-model-count>{models.length}</span> PUBLISHED RUNS</span
        ><button class="control" id="fullscreen" aria-label="Enter fullscreen"
          ><span aria-hidden="true">⛶</span><span class="fullscreen-label">
            Fullscreen</span
          ><span class="key">F</span></button>
      </div>
    </header>
    <nav class="rail" aria-label="Scenes">
      <button data-scene="0" aria-label="Scene 1: Live run" aria-current="true"
        ><span>01</span><i></i></button
      ><button
        data-scene="1"
        aria-label="Scene 2: Flame stack"
        aria-current="false"><span>02</span><i></i></button
      ><button
        data-scene="2"
        aria-label="Scene 3: Value frontier"
        aria-current="false"><span>03</span><i></i></button
      ><button
        data-scene="3"
        aria-label="Scene 4: Model focus"
        aria-current="false"><span>04</span><i></i></button>
    </nav>
    <main id="experience">
      <section class="scene" id="scene-1">
        <div class="scene-head replay-head">
          <div class="scene-intro">
            <p class="eyebrow">
              <b>01 / Live run</b> &nbsp; A replay of real results
            </p><h1 id="opening-title" tabindex="-1">
              Put every model<br /> under load.
            </h1><p class="subcopy">
              Open benchmarking for AI performance test scripting and
              engineering.
            </p>
          </div><div class="replay-stats">
            <div>
              <div class="big-counter">
                <span id="leading-score">0.00</span><small> / 100</small>
              </div><p class="stat-label">LEADING WEIGHTED SCORE</p>
            </div><div>
              <div class="sample-count">
                <span id="sample-count">0</span><small> / <span data-sample-total>{totalSamples}</span></small>
              </div><p class="stat-label">SAMPLES LANDED</p>
            </div>
          </div>
        </div>
        <div class="run-toolbar">
          <span class="run-state" id="run-state"
            >REPLAYING PUBLISHED SAMPLES</span
          ><div class="run-buttons">
            <button class="control" id="pause">Pause</button><button
              class="control"
              id="finish">Settle results ↗</button>
          </div>
        </div>
        <div class="sample-head tool-group-head">
          <div class="tool-heads" id="tool-heads"></div>
        </div>
        <div class="sample-head task-index-head">
          <span>#</span><span>MODEL / PROVIDER</span><div
            class="task-heads"
            id="task-heads"
          >
          </div><span style="text-align:right">TOOL PASSES · SCORE</span>
        </div><div class="lanes" id="lanes"></div>
        <div class="sr" id="lane-descriptions"></div>
        <div class="scene-foot">
          <div class="legend-inline">
            <span><i style="background:var(--lime)"></i>Pass</span><span
              ><i style="background:var(--fail)"></i>Fail ×</span
            ><span><i class="unrun-key"></i>Not run</span><span>Press a lane to inspect ↗</span>
          </div><span
            ><span data-task-count>{uniqueTasks}</span> tasks · <span data-model-count>{models.length}</span> models · Published attempts<br
            /><b>Animated replay, not a running benchmark.</b></span>
        </div>
      </section>
      <section class="scene" id="scene-2">
        <div class="scene-head stack-top">
          <div class="scene-intro">
            <p class="eyebrow">
              <b>02 / Flame stack</b> &nbsp; Follow the contribution
            </p><h2 tabindex="-1">Where the score<br />catches fire.</h2><p
              class="subcopy"
            >
              Every segment earns its space. Zoom into a category to find what
              holds up.
            </p>
          </div><aside class="stack-info" aria-label="Selected category">
            <strong id="stack-info-title">{activeWeight} active points</strong
            ><p id="stack-info-detail">
              Scores are normalized across the <span data-active-count>{active.length}</span> categories with tasks.
              Empty categories never count as zero.
            </p>
          </aside>
        </div>
        <div class="stack-tools">
          <nav class="breadcrumb" aria-label="Flame zoom">
            <button id="zoom-out">All categories</button><span id="zoom-path"
              >/ Weighted contribution</span>
          </nav><span class="muted" style="font-size:0.75rem"
            >HOVER TO LIFT · CLICK TO ZOOM</span>
        </div>
        <div id="flames"></div><div
          id="category-legend"
          class="legend"
          aria-label="Zoom into category"
        >
        </div><div class="not-run" id="not-run">
          {
            inactive.map((c) => (
              <div class="empty-frame">
                <>
                  <b>
                    {c[0].toUpperCase() + c.slice(1)} / weight {weights[c]}
                  </b>
                  <span>Not yet benchmarked</span>
                </>
              </div>
            ))
          }
        </div><div class="scene-foot">
          <span
            >Segment width = category score × weight / <span data-active-weight>{activeWeight}</span>.<br />In
            category view, width = category score.</span
          ><span
            >THE UNMEASURED CATEGORIES<br /><b
              >Visible absence. No invented scores.</b
            ></span>
        </div>
      </section>
      <section class="scene" id="scene-3">
        <div class="scene-head frontier-head">
          <div class="scene-intro">
            <p class="eyebrow">
              <b>03 / Value frontier</b> &nbsp; Spend with intent
            </p><h2 tabindex="-1">Performance.<br /> Priced in.</h2><p
              class="subcopy"
            >
              Find the strongest run inside your budget.<br />Drag the lime
              handle. Watch the field narrow.
            </p>
          </div><div class="value-winner">
            <p class="eyebrow">BEST WITHIN YOUR BUDGET</p><h3 id="winner-name">
            </h3><p class="winner-meta" id="winner-meta"></p>
          </div>
        </div>
        <figure class="chart-shell">
          <svg
            id="scatter"
            class="scatter"
            aria-labelledby="chart-title chart-desc"
            ><title id="chart-title">
              Published model score versus run cost
            </title><desc id="chart-desc"
              >Higher is better. Costs use a logarithmic horizontal scale. The
              lime line joins nondominated runs. Use the labeled budget slider
              or select a numbered model to inspect it.</desc
            ></svg
          ><div class="budget-slider-wrap">
            <label class="sr" for="budget"
              >Maximum estimated run cost in USD, logarithmic scale</label
            ><input
              id="budget"
              type="range"
              min="0"
              max="1000"
              step="1"
              aria-describedby="budget-hint"
            />
          </div><div class="budget-label">
            <label for="budget"
              >YOUR RUN BUDGET <span class="accent">↔</span></label
            ><output id="budget-value" for="budget"></output>
          </div><div class="chart-models" id="chart-models"></div><figcaption
            id="budget-hint"
            class="chart-caption"
          >
            Logarithmic cost axis · Higher score, lower cost is better · Cost
            estimates use returned token usage and list prices, not billing
            invoices.
          </figcaption>
        </figure>
        <details class="data-disclosure">
          <summary>Read the chart as a data table ↗</summary><table>
            <caption
              ><span data-model-count>{models.length}</span> visible published runs. Score is out of 100.</caption
            ><thead
              ><tr
                ><th scope="col">Rank</th><th scope="col">Model</th><th scope="col">Score</th><th
                  scope="col">Cost (USD)</th
                ></tr
              ></thead
            ><tbody id="chart-table"></tbody>
          </table>
        </details>
        <div class="scene-foot">
          <span
            >Direct provider APIs. Published tasks and attempts.<br />No
            confidence intervals from single runs.</span
          ><span
            >FRONTIER ≠ EVERY CAPABILITY<br /><b
              >Inspect the tasks, not just the point.</b
            ></span>
        </div>
      </section>
      <section class="scene" id="scene-4">
        <div class="scene-head focus-head">
          <div>
            <p class="eyebrow">
              <b>04 / Model focus</b> &nbsp; The evidence beneath the score
            </p><h2 id="focus-name" tabindex="-1"></h2><p
              class="muted"
              id="focus-provider"
              style="margin-top:10px"
            >
            </p>
            <p id="focus-version" class="model-version"></p>
          </div><div class="model-controls">
            <button
              class="control"
              id="previous-model"
              aria-label="Previous model">←</button
            ><label class="sr" for="model-picker">Choose a model</label><select
              id="model-picker"></select><button
              class="control"
              id="next-model"
              aria-label="Next model">→</button>
          </div>
        </div><div class="profile">
          <div class="profile-left">
            <figure>
              <div class="ring-wrap">
                <svg
                  id="ring"
                  viewBox="0 0 260 260"
                  role="img"
                  aria-label="Weighted category score ring"></svg><div
                  class="ring-center"
                >
                  <div class="ring-score" id="focus-score"></div><p
                    class="muted"
                  >
                    WEIGHTED / 100
                  </p>
                </div>
              </div><figcaption class="ring-caption" id="ring-caption">
                {active.length} measured categories. Every point traceable.
              </figcaption>
            </figure><div id="cat-keys" class="cat-keys"></div>
          </div><div class="profile-right">
            <div class="task-header">
              <h3>Samples, not promises.</h3><span
                class="muted"
                id="focus-passed"></span>
            </div><div class="task-grid" id="task-grid"></div><div
              class="metrics"
            >
              <div>
                <div class="metric-value" id="focus-cost"></div><p
                  class="metric-label"
                >
                  ESTIMATED RUN COST
                </p><p class="metric-note">USD · list-price estimate</p>
              </div><div>
                <div class="metric-value" id="focus-tokens"></div><p
                  class="metric-label"
                >
                  TOTAL TOKENS
                </p><p class="metric-note" id="focus-token-detail"></p>
              </div><div>
                <div class="metric-value" id="focus-latency"></div><p
                  class="metric-label"
                >
                  API LATENCY
                </p><p class="metric-note" id="focus-latency-detail">
                  Total across published requests
                </p>
              </div>
            </div><p class="profile-provenance" id="focus-provenance"></p>
          </div>
        </div><div class="scene-foot">
          <span
            >← → to change model · Select any lane or chart point to open this
            view.<br />Pass/fail reflects each task's exact grading contract.
            <a href="#scenarios">Explore scenarios ↗</a></span
          ><span
            >REAL ARTIFACTS. OPEN HARNESS.<br /><b
              >No hidden prompts. No synthetic models.</b
            ></span>
        </div>
      </section>
      <section class="reading-section scenarios" id="scenarios" aria-labelledby="scenarios-title">
        <p class="eyebrow">05 / INSIDE THE TASK PACK</p>
        <h2 id="scenarios-title" tabindex="-1">Scenarios.<br />Every task, in the open.</h2>
        <p class="subcopy">What models must do, how we grade it and where they succeed.
          Pass rates always use the {models.length} latest published model families, even when earlier versions are shown.</p>
        <div class="scenario-toolbar">
          <div class="scenario-filters" role="group" aria-label="Filter scenarios by tool">
            {filters.map(filter => <button class="control" type="button"
              data-scenario-filter={filter.tool} aria-pressed={filter.tool === 'all' ? 'true' : 'false'}
              aria-controls="scenario-list">{filter.label}</button>)}
          </div>
          <p class="scenario-count" id="scenario-count">Showing {scenarios.length} of {scenarios.length} scenarios</p>
        </div>
        <ul class="scenario-list" id="scenario-list" role="list">
          {scenarios.map(scenario => <li class="scenario-card" data-scenario-tool={scenario.tool}>
            <div class="scenario-tags"><span>{scenario.category}</span><span>{scenario.toolLabel}</span></div>
            <h3>{scenario.title}</h3>
            {scenario.title !== scenario.id && <code>{scenario.id}</code>}
            <dl>
              <div><dt>The task</dt><dd>{scenario.summary}</dd></div>
              <div><dt>How it is graded</dt><dd>{scenario.grading}</dd></div>
            </dl>
            <div class="scenario-results">
              <strong>{scenario.passLabel}</strong>
              {scenario.notRun > 0 && <span>{scenario.notRun} not run</span>}
            </div>
          </li>)}
        </ul>
        <p class="scenario-empty" id="scenario-empty" hidden={scenarios.length > 0}>No scenarios match this tool.</p>
        <p class="scenario-note">A model passes a scenario only if every published attempt passes.
          Missing attempts are shown as not run, not failed. Descriptions come from the checked-in task definitions.</p>
      </section>
      <section class="reading-section" id="tools">
        <p class="eyebrow">06 / PICK YOUR INSTRUMENT</p><h2 tabindex="-1">
          Built for the tools you use.
        </h2>
        <p class="subcopy">Executable plans first. More engines next.</p>
        <div class="tools-grid">
          <article class="tool-card active-tool">
            <h3>JMeter</h3><div class="tool-heading">
              Real scripts.<br />Real checkouts.
            </div><p class="tool-note mono">Executable task pass rate</p>
            <ol role="list">
              {
                toolRanking.map((m) => (
                  <li data-tool-model={m.model} hidden={m.newer_model !== null} class={m.discontinued ? 'is-discontinued' : undefined}>
                    <>
                      <span>{name(m.model)}<span class="model-version">{m.version_status}{m.newer_model && <small class="newer-tag">newer: {name(m.newer_model)}</small>}{m.discontinued && <span> · Discontinued</span>}</span></span>
                      <b class={toolScore(m, "jmeter") === null ? 'tool-unrun' : undefined}>{toolScoreLabel(m, "jmeter")}</b>
                    </>
                  </li>
                ))
              }
            </ol>
          </article>
          <article class="tool-card active-tool">
            <h3>k6</h3><div class="tool-heading">
              Real scripts.<br />Real checkouts.
            </div><p class="tool-note mono">Executable task pass rate</p>
            <ol role="list">
              {
                k6Ranking.map((m) => (
                  <li data-tool-model={m.model} hidden={m.newer_model !== null} class={m.discontinued ? 'is-discontinued' : undefined}>
                    <span>{name(m.model)}<span class="model-version">{m.version_status}{m.newer_model && <small class="newer-tag">newer: {name(m.newer_model)}</small>}{m.discontinued && <span> · Discontinued</span>}</span></span>
                    <b class={toolScore(m, "k6") === null ? 'tool-unrun' : undefined}>{toolScoreLabel(m, "k6")}</b>
                  </li>
                ))
              }
            </ol>
          </article>
          {
            ["Gatling", "Locust"].map((tool, i) => (
              <article class="tool-card">
                <>
                  <h3>{tool}</h3>
                  <div class="tool-heading">
                    Next in
                    <br />
                    the pipeline.
                  </div>
                  <div class="mini-flame" aria-hidden="true">
                    {[1, 2, 3].map((n) => (
                      <i
                        style={`--heat:${Object.values(colors)[i + n - 1]};width:${90 - n * 20}%`}
                      />
                    ))}
                  </div>
                  <p class="coming mono">Graders coming</p>
                </>
              </article>
            ))
          }
        </div>
        <p class="footnote">
          JMeter and k6 scores = percentage of executable tasks passed per tool. No scores are
          assigned to tools without graders. Provider timeouts with no returned
          attempts are shown as Not run, not counted as failures.
        </p>
      </section>

      <section class="reading-section methodology" id="method">
        <div>
          <p class="eyebrow">07 / SHOW YOUR WORK</p><h2 tabindex="-1">
            A benchmark.<br />Not a black box.
          </h2><a class="repo-link mono" href={repo}
            >Explore the harness on GitHub ↗</a>
        </div>
        <div class="method-copy">
          <p>
            Direct provider APIs. Temperature 0 where supported; omitted for
            Claude Sonnet 5.5, Opus 5.5, GPT-6.2 Sol and Astra because their
            APIs reject it. OpenAI uses max_completion_tokens instead of
            max_tokens. One fixed system prompt and identical task prompts for
            every model. No routing layer.
          </p>
          <p>
            Generated JMeter plans and k6 v1.0.0 scripts run against a loopback
            demo shop. Passing requires successful HTTP samples, verified
            session-aware checkouts and distinct checkout workers for isolation.
            Completed k6 attempts were run separately and appended to original
            attempts, preserving the original system prompt and provider settings.
            Numeric and choice tasks use deterministic answer keys.
          </p>
          <p>
            Category means are weighted, then renormalized over categories with
            tasks. Unmeasured categories stay unmeasured, never zero.
          </p>
          <div class="weight-list mono">
            {
              categories.map((c) => (
                <span>
                  <i style={`background:${colors[c]}`} />
                  {c}
                  <b>{weights[c]}</b>
                </span>
              ))
            }
          </div>
          <p>
            Cost is estimated from published peak list prices, including
            cache-hit pricing. It is not an invoice. Latency measures provider
            calls, excluding grading.
          </p>
          <p class="small-copy">
            This public seed pack is small: one run per model, not a confidence
            interval. DeepSeek thinking is disabled. Output cap: 8,192 tokens.
            Tool scores and overall scores measure different slices.
          </p>
        </div>
        <div class="legal">
          <span>Open source · MIT · P95 Bench</span><span
            >© 2026 NaveenKumar Namachivayam</span>
        </div>
      </section>
    </main>
    <footer>
      <div class="footer-left">
        <span class="line"></span><span id="scene-label">01 / LIVE RUN</span
        ><span class="desktop-help"
          ><span data-task-count>{uniqueTasks}</span> TASKS · <span data-model-count>{models.length}</span> MODELS · DIRECT APIs</span>
      </div><div class="footer-right">
        <span class="desktop-help"
          >SCROLL TO EXPLORE &nbsp; <span class="key">1</span>
          <span class="key">2</span>
          <span class="key">3</span>
          <span class="key">4</span></span
        ><button id="next-scene"
          >NEXT SCENE <span aria-hidden="true">↓</span></button>
      </div>
    </footer><div id="status" class="sr" role="status" aria-live="polite" aria-atomic="true"></div>
    <noscript
      ><p>
        The interactive scenes need JavaScript. <a href="#tools"
          >Read tool coverage</a
        > or <a href="#method">explore the methodology</a> below.
      </p></noscript
    >

    <script>
      import "../lib/fullpage.mjs";
    </script>
  </body>
</html>
